# LLM Provider Selection ("claude", "gemini", or "grok")
LLM_PROVIDER=grok

# API Keys (never commit the actual .env file)
# Required when LLM_PROVIDER=grok
GROK_API_KEY=your_xai_grok_key_here

# Required when LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=your_key_here

# Required when LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here

# Optional model override for Grok (defaults to grok-2-latest)
# GROK_MODEL=grok-2-latest

# Required for sandbox execution
# E2B_API_KEY=your_key_here

# Database
# POSTGRES_URL=postgresql://user:password@localhost:5432/ai_app_builder
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# Server
HOST=0.0.0.0
PORT=8000
